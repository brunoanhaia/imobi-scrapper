# Non-secret settings for the Dockhand stack (deploy.compose.yaml).
# The secrets POSTGRES_PASSWORD, ADMIN_PASSWORD and ADMIN_SECRET_KEY belong in
# Dockhand Secrets (or in the stack environment), never in the repository.

IMOBI_VERSION=latest
APP_DOMAIN=imoveis.example.com
TRAEFIK_MIDDLEWARES=security-headers@file,tinyauth@file

POSTGRES_USER=imobi
POSTGRES_DB=imobi

ADMIN_USER=admin

CRITERIA_MIN_PRICE=100000
CRITERIA_MAX_PRICE=600000
RATE_LIMIT_SECONDS=3.0
MAX_PAGES_PER_SOURCE=90
SCRAPE_INTERVAL_SECONDS=21600
BACKUP_MAX_UPLOAD_MB=512
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
