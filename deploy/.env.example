# Non-secret settings for the Dockhand stack (deploy.compose.yaml).
# The secrets POSTGRES_PASSWORD, DATABASE_URL, ADMIN_PASSWORD and ADMIN_SECRET_KEY belong in
# Dockhand Secrets (or in the stack environment), never in the repository.

POSTGRES_USER=imovel
POSTGRES_DB=imovel
# Keep the password in DATABASE_URL identical to POSTGRES_PASSWORD (Dockhand Secret).
DATABASE_URL=postgresql+psycopg://imovel:<POSTGRES_PASSWORD>@db:5432/imovel

ADMIN_USER=admin
APP_DOMAIN=imoveis.example.com

CRITERIA_MIN_PRICE=100000
CRITERIA_MAX_PRICE=600000
RATE_LIMIT_SECONDS=3.0
MAX_PAGES_PER_SOURCE=90
SCRAPE_INTERVAL_SECONDS=21600
BACKUP_MAX_UPLOAD_MB=512
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# Traefik / TinyAuth labels (defaults already match the usual names).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
TINYAUTH_MIDDLEWARE=tinyauth@file
