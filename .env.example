# Copy to .env before `docker compose up`. Also used for local (non-container) runs.
# Change POSTGRES_PASSWORD, ADMIN_PASSWORD and ADMIN_SECRET_KEY before exposing the app.

# --- database -----------------------------------------------------------------
POSTGRES_USER=imobi
POSTGRES_PASSWORD=imobi
POSTGRES_DB=imobi
# Used by the app containers (host `db` is the compose service name).
DATABASE_URL=postgresql+psycopg://imobi:imobi@db:5432/imobi
# For a local run without a database container:
# DATABASE_URL=sqlite:///data/imobi.db

# --- web UI -------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET_KEY=change-me-too
APP_PORT=8080

# --- default criteria (a `criteria` row, editable in /admin, takes precedence) --
CRITERIA_MIN_PRICE=100000
CRITERIA_MAX_PRICE=600000

# --- politeness / safety limits -----------------------------------------------
RATE_LIMIT_SECONDS=3.0
MAX_PAGES_PER_SOURCE=90
# Seconds between scheduled collections (default: 6 hours).
SCRAPE_INTERVAL_SECONDS=21600

# --- web deployment / reverse proxy -------------------------------------------
# Production behind HTTPS: true. Keep false for http://localhost.
SESSION_HTTPS_ONLY=false
# Comma-separated hostnames accepted by TrustedHostMiddleware (empty = disabled).
ALLOWED_HOSTS=
# IPs allowed to send X-Forwarded-* headers (Traefik runs on another container IP).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- on-demand backup page (web UI) -------------------------------------------
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_MAX_UPLOAD_MB=512
BACKUP_TIMEOUT_SECONDS=300
# Shared by the app and the scraper: the maintenance flag lives here.
STATE_DIR=data

# --- CLI dump script only (scripts/backup.sh) ---------------------------------
# The web page downloads a dump to the browser; these settings are for the old CLI loop.
BACKUP_KEEP=7
BACKUP_INTERVAL_SECONDS=86400

# --- image proxy (on-demand thumbnails) ---------------------------------------
IMAGES_CACHE_DIR=data/img-cache
IMAGES_CACHE_MAX_MB=2048
IMAGES_MAX_BYTES=8388608
IMAGES_NEGATIVE_TTL_SECONDS=86400

TZ=America/Sao_Paulo
LOG_LEVEL=INFO
