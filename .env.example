# Copy to .env before `docker compose up`. Also used for local (non-container) runs.

# --- database -----------------------------------------------------------------
POSTGRES_USER=imovel
POSTGRES_PASSWORD=imovel
POSTGRES_DB=imovel
# Used by the app containers (host `db` is the compose service name).
DATABASE_URL=postgresql+psycopg://imovel:imovel@db:5432/imovel
# For a local run without a database container:
# DATABASE_URL=sqlite:///data/imovel.db

# --- web UI -------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET_KEY=change-me-too
APP_PORT=8000

# --- default criteria (a `criteria` row, editable in /admin, takes precedence) --
CRITERIA_MIN_PRICE=100000
CRITERIA_MAX_PRICE=600000

# --- politeness / safety limits -----------------------------------------------
RATE_LIMIT_SECONDS=2.0
MAX_PAGES_PER_SOURCE=40
# Seconds between scheduled collections (default: 6 hours).
SCRAPE_INTERVAL_SECONDS=21600

TZ=America/Sao_Paulo
LOG_LEVEL=INFO
