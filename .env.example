# Copy to .env and adjust. All values are read by pydantic-settings (env var, case-insensitive).

# Postgres (default when running via docker/podman compose)
DATABASE_URL=postgresql+psycopg://imovel:imovel@db:5432/imovel
# For a quick local run without a database container:
# DATABASE_URL=sqlite:///data/imovel.db

# Admin UI (basic auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET_KEY=change-me-too

# Default criteria (a `criteria` row, editable in /admin, takes precedence)
CRITERIA_MIN_PRICE=100000
CRITERIA_MAX_PRICE=600000

# Politeness / safety limits
RATE_LIMIT_SECONDS=2.0
MAX_PAGES_PER_SOURCE=40
MAX_ITEMS_PER_RUN=1500

TZ=America/Sao_Paulo
LOG_LEVEL=INFO
